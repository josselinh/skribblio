# Copy to .env.docker for local development. Replace the example passwords locally.
APP_NAME=Skribblio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=local-dev-password
DB_ROOT_PASSWORD=local-dev-root-password
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=local-dev-password
MYSQL_ROOT_PASSWORD=local-dev-root-password

BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_PORT=8080
DOCKER_UID=1000
DOCKER_GID=1000
